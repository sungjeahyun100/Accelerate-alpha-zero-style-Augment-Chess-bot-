{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-v1.schema.json",
  "title": "Accelerate runtime contracts v1",
  "description": "Versioned storage/oracle contracts. Opaque native Position/Action objects carry the same data; these JSON shapes are not required on the hot path. Identity uses RFC 8785 canonical JSON SHA-256.",
  "$defs": {
    "Color": {
      "enum": [
        "white",
        "black"
      ]
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Coord": {
      "type": "object",
      "required": [
        "row",
        "col"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "additionalProperties": true
    },
    "Board": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 8,
        "maxItems": 8,
        "items": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "Rng": {
      "type": "object",
      "required": [
        "algorithm",
        "state",
        "cursor",
        "tape"
      ],
      "properties": {
        "algorithm": {
          "const": "lcg32-v1"
        },
        "state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tape": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Position": {
      "type": "object",
      "required": [
        "protocolVersion",
        "rulesVersion",
        "catalogVersion",
        "state",
        "rng",
        "history",
        "positionId"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-position-v1"
        },
        "rulesVersion": {
          "const": "augment-site-20260927-abfe01a035813875"
        },
        "catalogVersion": {
          "const": "yt63f_Lcq4xUPu4GbbdwAyv5IUTuC079nNxvF3IFrj4"
        },
        "state": {
          "type": "object",
          "required": [
            "board",
            "turn",
            "mode"
          ],
          "properties": {
            "board": {
              "$ref": "#/$defs/Board"
            },
            "turn": {
              "$ref": "#/$defs/Color"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "rng": {
          "$ref": "#/$defs/Rng"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GameEvent"
          }
        },
        "positionId": {
          "$ref": "#/$defs/Hash"
        }
      },
      "additionalProperties": false
    },
    "ActionPayload": {
      "type": "object",
      "required": [
        "type",
        "color"
      ],
      "properties": {
        "type": {
          "enum": [
            "move",
            "card",
            "promotion",
            "promotionChoice",
            "shotgunReload",
            "wizardSpell",
            "fileSurgeSkip",
            "draftPick",
            "draftBundlePick",
            "trolleyChoice"
          ]
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "from": {
          "$ref": "#/$defs/Coord"
        },
        "move": {
          "$ref": "#/$defs/Coord"
        },
        "cardId": {
          "type": "string",
          "minLength": 1
        },
        "cardInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "object",
            "null"
          ]
        },
        "promotionType": {
          "type": "string",
          "minLength": 1
        },
        "spellId": {
          "enum": [
            "meteor",
            "lightning",
            "shield",
            "timeStop"
          ]
        },
        "bundleIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "cardInstanceIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "windowId": {
          "type": "string",
          "minLength": 1
        },
        "doomedIndex": {
          "enum": [
            0,
            1
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "move"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "card"
              }
            }
          },
          "then": {
            "required": [
              "cardId",
              "cardInstanceId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "promotion",
                  "shotgunReload",
                  "fileSurgeSkip"
                ]
              }
            }
          },
          "then": {
            "required": [
              "from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "promotionChoice"
              }
            }
          },
          "then": {
            "required": [
              "promotionType"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wizardSpell"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "spellId",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "draftPick"
              }
            }
          },
          "then": {
            "required": [
              "cardInstanceId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "draftBundlePick"
              }
            }
          },
          "then": {
            "required": [
              "bundleIndex",
              "cardInstanceIds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trolleyChoice"
              }
            }
          },
          "then": {
            "required": [
              "windowId",
              "doomedIndex"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "Action": {
      "type": "object",
      "required": [
        "protocolVersion",
        "positionId",
        "actionId",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-action-v1"
        },
        "positionId": {
          "$ref": "#/$defs/Hash"
        },
        "actionId": {
          "$ref": "#/$defs/Hash"
        },
        "payload": {
          "$ref": "#/$defs/ActionPayload"
        }
      },
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "required": [
        "protocolVersion",
        "viewer",
        "board",
        "turn",
        "ownCards",
        "opponentHandCount",
        "publicState",
        "history",
        "informationStateKey"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-observation-v1"
        },
        "viewer": {
          "$ref": "#/$defs/Color"
        },
        "board": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PublicPiece"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "turn": {
          "$ref": "#/$defs/Color"
        },
        "ownCards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicCard"
          }
        },
        "opponentHandCount": {
          "type": "integer",
          "minimum": 0
        },
        "publicState": {
          "type": "object",
          "properties": {
            "acceleration": {},
            "accelerationPendingFor": {},
            "accelerationPendingTurns": {},
            "accelerationStartsAfterBlackTurns": {},
            "actionsRemaining": {},
            "armistice": {},
            "assembly": {},
            "backwardKnight": {},
            "binaMate": {},
            "bishopInfiltration": {},
            "bishopSnipe": {},
            "blackHole": {},
            "boardFlip": {},
            "captureTheFlag": {},
            "capturedTypes": {},
            "cardsUsedThisTurn": {},
            "castled": {},
            "castlingCanceled": {},
            "clonePassive": {},
            "collapseDepth": {},
            "collapsed": {},
            "collapsedCells": {},
            "completeRandom": {},
            "conscription": {},
