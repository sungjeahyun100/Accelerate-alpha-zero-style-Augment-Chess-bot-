            "winner": {},
            "winterKingdom": {},
            "phase": {},
            "draft": {},
            "revealedOpponentCards": {},
            "ownStarTotal": {},
            "opponentStarTotal": {},
            "ruleCardIds": {},
            "rulesVersion": {},
            "catalogVersion": {},
            "captures": {},
            "clock": {},
            "lastMove": {},
            "selectionPhase": {},
            "legalHints": {},
            "tabooPending": {},
            "ownPlans": {}
          },
          "additionalProperties": false
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicTransition"
          }
        },
        "informationStateKey": {
          "$ref": "#/$defs/Hash"
        }
      },
      "additionalProperties": false
    },
    "GameResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "status",
        "winner",
        "outcome",
        "reason"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-result-v1"
        },
        "status": {
          "enum": [
            "ongoing",
            "terminal",
            "unfinished"
          ]
        },
        "winner": {
          "enum": [
            null,
            "white",
            "black"
          ]
        },
        "outcome": {
          "enum": [
            null,
            "white",
            "black",
            "draw"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "StepResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "position",
        "result"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-step-v1"
        },
        "ok": {
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "result": {
          "$ref": "#/$defs/GameResult"
        },
        "event": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "PublicTransition": {
      "type": "object",
      "required": [
        "kind",
        "actor",
        "nextActor",
        "phase",
        "boardChanges",
        "ownCards",
        "revealedOpponentCards",
        "captures",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "transition"
        },
        "actor": {
          "$ref": "#/$defs/Color"
        },
        "nextActor": {
          "$ref": "#/$defs/Color"
        },
        "phase": {
          "type": "string"
        },
        "boardChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "square",
              "before",
              "after"
            ],
            "properties": {
              "square": {
                "$ref": "#/$defs/Coord"
              },
              "before": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PublicPiece"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PublicPiece"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "ownCards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicCard"
          }
        },
        "revealedOpponentCards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicCard"
          }
        },
        "captures": {
          "$ref": "#/$defs/PublicCaptures"
        },
        "result": {
          "$ref": "#/$defs/GameResult"
        }
      },
      "additionalProperties": false
    },
    "GameEvent": {
      "type": "object",
      "required": [
        "protocolVersion",
        "actor",
        "action",
        "turnChanged",
        "public"
      ],
      "properties": {
        "protocolVersion": {
          "const": "accelerate-game-event-v1"
        },
        "actor": {
          "$ref": "#/$defs/Color"
        },
        "action": {
          "$ref": "#/$defs/ActionPayload"
        },
        "turnChanged": {
          "type": "boolean"
        },
        "public": {
          "type": "object",
          "required": [
            "white",
            "black"
          ],
          "properties": {
            "white": {
              "$ref": "#/$defs/PublicTransition"
            },
            "black": {
              "$ref": "#/$defs/PublicTransition"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
