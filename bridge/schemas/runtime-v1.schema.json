            "recycling": {},
            "religiousVictory": {},
            "resolve": {},
            "roller": {},
            "royalKnightKing": {},
            "ruleOpeningEnabled": {},
            "ruleSelectionEnabled": {},
            "selectedRuleCardId": {},
            "selectedRuleCardIds": {},
            "shotgunDlc": {},
