          ]
        },
        "color": {
          "enum": [
            "white",
            "black",
            "neutral"
          ]
        },
        "logDir": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "windmillMode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PublicCaptures": {
      "type": "object",
      "required": [
        "white",
        "black"
      ],
      "properties": {
