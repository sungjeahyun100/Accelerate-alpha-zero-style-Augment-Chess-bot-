# Rust (Cargo.lock is intentionally NOT ignored -- rust-engine is an application, not a
# library, so it should be committed for reproducible builds)
rust-engine/target/
**/*.rs.bk

# Python
python/**/__pycache__/
python/**/*.pyc
python/.venv/
python/venv/
*.egg-info/

# Node (infra/, tooling)
node_modules/
npm-debug.log*

# Model weights / checkpoints / large data (keep code, not generated artifacts)
*.pt
*.pth
*.ckpt
*.onnx
python/**/checkpoints/
python/**/runs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
